## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## See https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
Log/
Logs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you use a glide to generate documentation
# docs/_site

# MSTest test Results
TestResults/
[Bb]uild[Ll]og.*

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# [Bb]in/
# [Oo]bj/

# Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

# User-specific files (Visual Studio Code)
.history/
.ionide/

# ASP.NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Publish output
/publish/

# AspNet5/vNext
.dnx/
.dnx_cache/
.dnx_packages/
.k-fast-check/
.k-fast-check-log/

# Node.js (if any frontend is used)
node_modules/
npm-debug.log
yarn-error.log

# Secret / Local Settings
appsettings.Development.json
secrets.json
.env

# MacOS files
.DS_Store
